      "options": "Print Label Format",
      "reqd": 1
    },
    {
      "fieldname": "start_position",
      "label": "Start Position",
      "fieldtype": "Int",
      "default": "1",
      "reqd": 1
    },
    {
      "fieldname": "label_count",
      "label": "Label Count",
      "fieldtype": "Int",
      "reqd": 1
    },
    {
      "fieldname": "layout_snapshot",
      "label": "Layout Snapshot",
      "fieldtype": "Long Text",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    }
  ]
