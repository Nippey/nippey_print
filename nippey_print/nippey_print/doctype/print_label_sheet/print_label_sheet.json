{
  "doctype": "DocType",
  "name": "Print Label Sheet",
  "module": "Nippey Print",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "autoname": "format:SHEET-{#####}",
  "field_order": [
    "label_format",
    "start_position",
    "label_count",
    "layout_snapshot"
  ],
  "fields": [
    {
      "fieldname": "label_format",
      "label": "Label Format",
